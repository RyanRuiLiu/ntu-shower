# ── 密钥与本地配置（绝不入库）──────────────────────────────
*.keystore
*.jks
*.p12
*.pfx
server/.env
.env
.env.*
!.env.example
!**/.env.example
android/gradle.properties
android/local.properties

# ── 安装包与发布物（由发布流程管理，不入库）─────────────────
*.apk
*.aab

# ── Python 构建产物与缓存 ──────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv*/
venv/
node_modules/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
coverage.json

# ── 服务端运行时数据 ──────────────────────────────────────
server/data/
server/ota_releases/

# ── Android / Gradle 构建产物 ─────────────────────────────
.gradle/
.kotlin/
build/

# ── 编辑器与系统 ──────────────────────────────────────────
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# ── 临时文件 ──────────────────────────────────────────────
*.log
*.tmp
*.orig
*.rej
# 本地质量门输出（报告随 CI 产生，不入库）。
# 用 *quality*.txt 而非 quality_*.txt：实际文件名是 android_quality.txt，
# 前缀式规则匹配不到，该文件因此被误入库并跟了很久。
*quality*.txt
*_check.txt
# 部署包：由 server/ 现打包产生，入库等于存一份代码副本
*.tar.gz

# ── 归档的原始资料 ────────────────────────────────────────
# 各份是什么、覆盖哪段时间，见 server/tools/replay_history.py 的模块注释。它们是设备与
# 旧系统的原话，不可再生，但都是二进制大文件（合计约 82MB），入库会让仓库永久膨胀。
# 只在本机留存，不进版本控制。
archive/*.db
archive/*.gz
