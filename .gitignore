__pycache__/
*.py[cod]
*.egg-info/
.eggs/
server/.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── 服务端运行时数据 ──────────────────────────────────────
server/data/
server/ota_releases/

