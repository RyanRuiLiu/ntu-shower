# 复制为 .env（真实 .env 已 gitignore）。字段定义见 app/core/config.py 的 Settings，
# 未声明的键会被忽略——不要写 config.py 里不存在的键。
# 容器部署时这些值由 compose 的 environment 与 env_file 注入，不由本文件决定路径。

# 数据库与产物目录（本地开发默认值；容器部署由 DB_PATH/OTA_DIR/VOICE_DIR 显式钉死）
DB_PATH=data/ntu-shower.db
VOICE_DIR=data/voice
OTA_DIR=ota_releases

# 管理台会话签名：留空则每次启动随机（重启后会话失效）。生产必须注入固定随机值。
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# 设备接入（fleet provisioning by claim）：
# DEVICE_ENROLL_TOKEN 必须与 APK 构建期注入的 claim 同值（gradle -PdeviceEnrollToken=...）。
# 留空 = 注册通道关闭（fail closed），新装 APK 的设备无法自注册。
# REQUIRE_DEVICE_TOKEN 保持 true：不留「不带凭据也能连」的旁路。
DEVICE_ENROLL_TOKEN=
REQUIRE_DEVICE_TOKEN=true

# 对外基址（Cookie 的 Secure 属性、问题文档的绝对引用）；必须 https
PUBLIC_BASE_URL=
LOG_LEVEL=INFO
