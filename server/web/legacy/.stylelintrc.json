{
  "$schema": "https://json.schemastore.org/stylelintrc.json",
  "rules": {
    "declaration-property-value-disallowed-list": {
      "/.*/": ["/#[0-9a-fA-F]{3,8}/", "/rgba?\\(/"],
      "font-size": ["/^(?!.*var\\(--fs-)/"],
      "border-radius": ["/^(?=(?:(?!var\\(--radius).)*$)(?=(?:(?!\\b0\\b).)*$)/"],
      "transition": ["/^(?!.*var\\(--transition)/"]
    }
  },
  "overrides": [
    {
      "files": ["**/tokens.css"],
      "rules": {
        "declaration-property-value-disallowed-list": null
      }
    }
  ]
}
