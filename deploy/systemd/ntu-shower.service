# /etc/systemd/system/ntu-shower.service
[Unit]
Description=NTU Shower Server (gateway + api + ops + ota)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ntu-shower/server
EnvironmentFile=/opt/ntu-shower/server/.env
ExecStart=/opt/ntu-shower/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
