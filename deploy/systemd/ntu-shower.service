# /etc/systemd/system/ntu-shower.service
[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=NTU Shower application server
Documentation=file:/opt/server-config/apps/ntu-shower/README.md
After=network.target

[Service]
Type=simple
User=ntu-shower
Group=ntu-shower
WorkingDirectory=/opt/ntu-shower/server
EnvironmentFile=/etc/ntu-shower/ntu-shower.env
ExecStart=/opt/ntu-shower/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8110
Restart=on-failure
RestartSec=3

# 加固基线（systemd.exec(5)）：全部置于 [Service]，[Install] 仅保留 WantedBy
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/ntu-shower

[Install]
WantedBy=multi-user.target
