# /etc/systemd/system/ntu-shower.service
[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=NTU Shower application server
Documentation=file:/opt/server-config/apps/ntu-shower/README.md
After=network.target

[Service]
Type=simple
User=ntu-shower
Group=ntu-shower
WorkingDirectory=/opt/ntu-shower/server
EnvironmentFile=/opt/ntu-shower/server/.env
ExecStart=/opt/ntu-shower/server/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8110
Restart=on-failure
RestartSec=3

# 加固：只读系统，仅应用目录可写
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/ntu-shower

[Install]
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
WantedBy=multi-user.target

