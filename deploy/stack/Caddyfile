# 唯一公网入口。通配符证书必须走 DNS-01，所以 Caddy 镜像要带 alidns 插件，
# 凭据由环境变量注入（.env 不进版本控制）。
#
# network_mode: host 下，127.0.0.1 指的是宿主，能直接够到各业务容器的回环端口
# 与 php-fpm 的 unix socket。
{
	acme_dns alidns {
		access_key_id {$ALIYUN_ACCESS_KEY_ID}
		access_key_secret {$ALIYUN_ACCESS_KEY_SECRET}
	}
}

iseekdream.com, *.iseekdream.com {
	# 通配符证书覆盖裸域与所有子域；acme_dns 是全局的，这里不再重复声明
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@www host www.iseekdream.com iseekdream.com
	handle @www {
		root * /srv/www
		file_server
	}

	@xyp host xyp.iseekdream.com
	handle @xyp {
		root * /srv/xyp/public
		php_fastcgi unix//run/php/php8.5-fpm.sock
		file_server
	}

	@shower host ntu-shower.iseekdream.com
	handle @shower {
		reverse_proxy 127.0.0.1:8110
	}

	@status host status-panel.iseekdream.com
	handle @status {
		reverse_proxy 127.0.0.1:8120
	}

	@geo host nexus-geo.iseekdream.com
	handle @geo {
		reverse_proxy 127.0.0.1:8100
	}

	# 未匹配的主机名直接关掉，不留默认站点
	handle {
		respond "Not found" 404
	}
}
