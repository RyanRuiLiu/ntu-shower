# 编排仓库的变量清单。真实 .env 不进版本控制（见仓库 .gitignore）。
# 换机时只需要 clone 仓库 + 放一份 .env + 恢复 /srv。

# 镜像：CI 构建后推到 registry，服务器只 pull，不在本机构建
CADDY_IMAGE=crpi-5rhaq5x8z5ec9tig.cn-hangzhou.personal.cr.aliyuncs.com/ryanruiliu/caddy-alidns:2.11.2
NTU_SHOWER_IMAGE=crpi-5rhaq5x8z5ec9tig.cn-hangzhou.personal.cr.aliyuncs.com/ryanruiliu/ntu-shower:REPLACE_WITH_SHA_TAG
STATUS_PANEL_IMAGE=crpi-5rhaq5x8z5ec9tig.cn-hangzhou.personal.cr.aliyuncs.com/ryanruiliu/status-panel:REPLACE_WITH_SHA_TAG

# 阿里云 DNS API：通配符证书 DNS-01 专用，最小权限子账号
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 管理台会话签名密钥；必须随机生成，绝不复用
SESSION_SECRET=
SESSION_TTL_SECONDS=43200

# 设备接入令牌默认强制校验；保持 true，不要关
REQUIRE_DEVICE_TOKEN=true

# 对外基址决定 Cookie 的 Secure 属性，必须是 https
PUBLIC_BASE_URL=https://ntu-shower.iseekdream.com

# 应用日志级别
LOG_LEVEL=INFO

# 换机时不设：迁移服务自己用 sqlite 路径；设了会覆盖
# DATABASE_URL=sqlite:////var/lib/ntu-shower/ntu-shower.db
