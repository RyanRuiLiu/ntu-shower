{
  "compilerOptions": {
    /* 严格度与服务端（mypy --strict）、设备端（allWarningsAsErrors）对齐。
       官方模板给的是 noImplicitAny:false + 仅 strictNullChecks，三端里最松，
       与本项目"越严格越好"的原则冲突，故收紧。 */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,

    /* 产物交给 Vite（Taro 的 compiler=vite），tsc 只做类型检查不产出 */
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* paths 不加 baseUrl：后者自 TS 4.4 起可用、5.x 已弃用、7.0 将移除。
       省略它时 paths 相对本文件所在目录解析，正是我们要的语义。 */
    "paths": {
      "@/*": ["./src/*"]
    },
    "typeRoots": ["node_modules/@types"]
  },
  "include": ["./src", "./types", "./config", "./vitest.config.ts"]
}
