{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntu-shower.iseekdream.com/schema/config.update.json",
  "title": "Server-pushed device configuration",
  "allOf": [
    {
      "$ref": "https://ntu-shower.iseekdream.com/schema/envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "config.update"
        },
        "payload": {
          "type": "object",
          "required": [
            "revision",
            "config"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "config": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}
