{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/ota.update_available.json",
  "title": "OTA update available for an online device",
  "allOf": [
    {
      "$ref": "https://example.com/schema/envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ota.update_available"
        },
        "payload": {
          "type": "object",
          "required": [
            "version",
            "version_code",
            "url"
          ],
          "properties": {
            "version": {
              "type": "string"
            },
            "version_code": {
              "type": "integer"
            },
            "url": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
