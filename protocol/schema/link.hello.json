{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntu-shower.iseekdream.com/schema/link.hello.json",
  "title": "Device hello (first message after connect)",
  "allOf": [
    {
      "$ref": "https://ntu-shower.iseekdream.com/schema/envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "link.hello"
        },
        "payload": {
          "type": "object",
          "required": [
            "device_id",
            "app_version",
            "os_version",
            "capabilities",
            "uptime_s"
          ],
          "properties": {
            "device_id": {
              "type": "string",
              "minLength": 8,
              "maxLength": 64
            },
            "app_version": {
              "type": "string"
            },
            "os_version": {
              "type": "string"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "version_code": {
              "type": "integer",
              "minimum": 0
            },
            "uptime_s": {
              "type": "integer",
              "minimum": 0,
              "description": "设备**自开机以来**的秒数（含深睡）。服务端拿收到它的时刻减去它，得到开机时刻；设备自己的墙上时钟准不准都不影响这件事——设备没有 NTP。"
            }
          }
        }
      }
    }
  ]
}
