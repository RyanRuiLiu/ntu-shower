{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/status_line.update.json",
  "title": "Fleet free-door status line",
  "allOf": [
    {
      "$ref": "https://example.com/schema/envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "status_line.update"
        },
        "payload": {
          "type": "object",
          "required": [
            "floors"
          ],
          "properties": {
            "floors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "device_id",
                  "name",
                  "online",
                  "free"
                ],
                "properties": {
                  "device_id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "online": {
                    "type": "boolean"
                  },
                  "free": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
