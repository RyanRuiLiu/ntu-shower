{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://<public-domain>/schema/link.hello_ack.json",
  "title": "Server hello acknowledgement",
  "allOf": [
    {
      "$ref": "https://<public-domain>/schema/envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "link.hello_ack"
        },
        "payload": {
          "type": "object",
          "required": [
            "trusted",
            "server_time",
            "config"
          ],
          "properties": {
            "trusted": {
              "type": "boolean"
            },
            "server_time": {
              "$ref": "https://<public-domain>/schema/envelope.json#/$defs/rfc3339"
            },
            "config": {
              "type": "object",
              "description": "设备端运行时配置。键集、类型、范围、默认值全部由服务端 modules/config/spec.py 的登记表定义——那里是唯一来源，这里不重复列举（抄一份必然漂移）。键按 scope=DEVICE 筛选后下发。"
            },
            "upgrade": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "version",
                    "version_code",
                    "url"
                  ],
                  "properties": {
                    "version": {
                      "type": "string"
                    },
                    "version_code": {
                      "type": "integer"
                    },
                    "sha256": {
                      "type": "string"
                    },
                    "mandatory": {
                      "type": "boolean"
                    },
                    "force": {
                      "type": "boolean"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
