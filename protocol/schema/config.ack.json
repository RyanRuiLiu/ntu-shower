{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntu-shower.iseekdream.com/schema/config.ack.json",
  "title": "Device acknowledgement of applied config revision",
  "allOf": [
    {
      "$ref": "https://ntu-shower.iseekdream.com/schema/envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "config.ack"
        },
        "payload": {
          "type": "object",
          "required": [
            "revision"
          ],
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  ]
}
