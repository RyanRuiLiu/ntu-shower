{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://<public-domain>/schema/envelope.json",
  "title": "ntu-shower message envelope",
  "type": "object",
  "required": [
    "v",
    "type",
    "id",
    "ts"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*\\.[a-z_]+$"
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "ts": {
      "$ref": "#/$defs/rfc3339"
    },
    "reply_to": {
      "$ref": "#/$defs/uuid"
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z_]+$"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
