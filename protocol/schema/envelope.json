{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntu-shower.iseekdream.com/schema/envelope.json",
  "title": "ntu-shower message envelope",
  "type": "object",
  "required": [
    "v",
    "type",
    "id",
    "ts"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z_]*\\.[a-z_]+$"
    },
    "id": {
      "$ref": "#/$defs/uuid"
    },
    "ts": {
      "$ref": "#/$defs/rfc3339"
    },
    "reply_to": {
      "$ref": "#/$defs/uuid"
    },
    "payload": {
      "type": "object",
      "description": "业务负载。消息按**开放扩展**设计：不声明 additionalProperties: false——新增可选字段不升协议版本，收端忽略不认识的键与类型（设备端 RuntimeConfig 对未知配置键跳过，网关对未知 type 只回 link.error 不断开）。各字段语义以每条消息 Schema 的 properties 为准；这是刻意的开放扩展决策（docs/DECISIONS.md「协议与契约」），不是遗漏。"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z]+\\.[a-z_]+$"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
