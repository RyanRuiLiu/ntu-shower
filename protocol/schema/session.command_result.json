{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://<public-domain>/schema/session.command_result.json",
  "title": "Device command result (reply_to = command id)",
  "allOf": [
    {
      "$ref": "https://<public-domain>/schema/envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.command_result"
        },
        "payload": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "ok",
                "failed",
                "blocked",
                "timeout"
              ]
            },
            "reason_code": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}
