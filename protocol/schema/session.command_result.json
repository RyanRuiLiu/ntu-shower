{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ntu-shower.iseekdream.com/schema/session.command_result.json",
  "title": "Device command result (reply_to = command id)",
  "allOf": [
    {
      "$ref": "https://ntu-shower.iseekdream.com/schema/envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "session.command_result"
        },
        "payload": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "ok",
                "failed",
                "timeout",
                "rejected"
              ],
              "description": "结果状态。ok=做完了；failed=动手了但没成；timeout=超过时限没有结论（不知成没成）；rejected=根本没动手（前置条件不满足，没有副作用，重试安全）。唯一来源是服务端的 core/outcomes.py。"
            },
            "reason_code": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        }
      }
    }
  ]
}
